# Snap origin - defaults to local dev snap server
# For production builds, set to: npm:@chainsafe/webzjs-zcash-snap
SNAP_ORIGIN="local:http://localhost:8080"

# Lightwalletd gRPC-web proxy - defaults to https://zcash-mainnet.chainsafe.dev
# Only override if running a local lightwalletd proxy
# LIGHTWALLETD_PROXY=http://localhost:1234/mainnet

# Dev server port - defaults to 3000
# PORT=3000

# Razorpay Standard Checkout (server-side only)
# Generate these in the Razorpay Dashboard. Never expose the secret to the browser.
# Use Test Mode keys while developing.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_test_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"
RAZORPAY_BUSINESS_NAME="WebZjs"

# Optional durable local payment store path.
# RAZORPAY_STORE_PATH="./data/razorpay.json"
